<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.fturleque</groupId>
    <artifactId>morpheus-engine</artifactId>
    <version>1.2.1</version>
    <packaging>pom</packaging>

    <name>MORPHEUS</name>
    <description>Specification &amp; Intent Intelligence Engine</description>

    <modules>
        <module>morpheus-domain</module>
        <module>morpheus-application</module>
        <module>morpheus-provider-sdk</module>
        <module>morpheus-provider-testkit</module>
        <module>morpheus-provider-reference</module>
        <module>morpheus-provider-openspec</module>
        <module>morpheus-provider-markdown</module>
        <module>morpheus-provider-synthetic</module>
        <module>morpheus-store-memory</module>
        <module>morpheus-store-sqlite</module>
        <module>morpheus-mcp-transport</module>
        <module>morpheus-integration-minos</module>
        <module>morpheus-integration-nexus</module>
        <module>morpheus-mcp</module>
        <module>morpheus-api</module>
        <module>morpheus-cli</module>
        <module>morpheus-architecture-tests</module>
        <module>morpheus-coverage-report</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
        <maven.compiler.release>21</maven.compiler.release>

        <!--
            Surefire's own default, declared so it can be referenced as ${skipTests}. The aggregate coverage
            gate has to re-enable itself for one execution bound to verify, and writing false there literally
            made it the one execution nobody could skip: `./mvnw verify -DskipTests` then failed on the last
            module, reporting a missing JaCoCo report rather than the skip that caused it.
        -->
        <skipTests>false</skipTests>

        <junit.version>6.1.3</junit.version>
        <archunit.version>1.5.0</archunit.version>
        <sqlite-jdbc.version>3.53.4.0</sqlite-jdbc.version>
        <mcp-sdk.version>2.0.1</mcp-sdk.version>
        <reactor-bom.version>2024.0.0</reactor-bom.version>
        <slf4j.version>2.0.20</slf4j.version>
        <jackson.version>3.2.3</jackson.version>

        <maven.compiler.plugin.version>3.16.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.6.0</maven.surefire.plugin.version>
        <maven.enforcer.plugin.version>3.6.3</maven.enforcer.plugin.version>
        <maven.jar.plugin.version>3.5.1</maven.jar.plugin.version>
        <maven.shade.plugin.version>3.6.2</maven.shade.plugin.version>
        <maven.dependency.plugin.version>3.11.0</maven.dependency.plugin.version>
        <jacoco.version>0.8.15</jacoco.version>
        <cyclonedx.maven.plugin.version>2.9.3</cyclonedx.maven.plugin.version>
        <dependency-check.maven.plugin.version>13.0.0</dependency-check.maven.plugin.version>
        <!--
            The H2 schema version Dependency-Check expects, read from `data.version` in the
            dependencycheck.properties of dependency-check-core. It is NOT the plugin version and does not
            track it: 12.2.2 and 13.0.0 both declare 5.6, with byte-identical data/initialize.sql and
            data/dbStatements.properties. Upstream changed the schema at 12.2.2, not at 13.0.0.

            It is pinned here because the CI cache key is built from it, so that a cached vulnerability
            database is reused exactly when the running analyzer can read it and never otherwise. Bumping
            the plugin above without checking this value is safe; changing this value is a deliberate cold
            start. DependencyCheckWorkflowContractTest keeps security.yml and this property in step.
        -->
        <dependency-check.data.version>5.6</dependency-check.data.version>

        <!--
            Audit tooling, active only through the audit-spotbugs and audit-mutation profiles. None of these
            plugins is bound to a default build: see docs/developer/CODE_AUDIT.md.

            spotbugs.version is the analysis engine, pinned next to its plugin so that bumping the plugin never
            changes which detectors run without anyone choosing it. pitest.junit5.plugin.version is the bridge
            PIT needs to run a JUnit Platform test; it is released on its own cadence, not with pitest.
        -->
        <spotbugs.maven.plugin.version>4.10.4.1</spotbugs.maven.plugin.version>
        <spotbugs.version>4.10.4</spotbugs.version>
        <pitest.maven.plugin.version>1.30.0</pitest.maven.plugin.version>
        <pitest.junit5.plugin.version>1.2.3</pitest.junit5.plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp-bom</artifactId>
                <version>${mcp-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- MCP SDK 2.0.1 is built on the Reactor 2024.0.x/3.7.x line. Keep the transport on that compatible train. -->
            <dependency>
                <groupId>io.projectreactor</groupId>
                <artifactId>reactor-bom</artifactId>
                <version>${reactor-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Align the API used transitively by MCP/networknt with the runtime SLF4J backend packaged by the CLI. -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                    <configuration>
                        <useModulePath>false</useModulePath>
                        <systemPropertyVariables>
                            <morpheus.project.version>${project.version}</morpheus.project.version>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven.jar.plugin.version}</version>
                    <configuration>
                        <archive>
                            <manifest>
                                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                                <addDefaultSpecificationEntries>true</addDefaultSpecificationEntries>
                            </manifest>
                        </archive>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven.enforcer.plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-foundation</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>[3.9.16,4.0.0)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                </requireJavaVersion>
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${maven.dependency.plugin.version}</version>
                <executions>
                    <execution>
                        <id>d2-dependency-hygiene</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>analyze-only</goal>
                        </goals>
                        <configuration>
                            <failOnWarning>true</failOnWarning>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedx.maven.plugin.version}</version>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>m21-aggregate-sbom</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>makeAggregateBom</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/m21-supply-chain</outputDirectory>
                            <outputName>morpheus-sbom</outputName>
                            <outputFormat>all</outputFormat>
                            <schemaVersion>1.6</schemaVersion>
                            <includeBomSerialNumber>false</includeBomSerialNumber>
                            <includeTestScope>false</includeTestScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>d2-security</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${dependency-check.maven.plugin.version}</version>
                        <inherited>false</inherited>
                        <configuration>
                            <format>ALL</format>
                            <failBuildOnCVSS>7.0</failBuildOnCVSS>
                            <junitFailOnCVSS>4.0</junitFailOnCVSS>
                            <failOnError>true</failOnError>
                            <failBuildOnUnusedSuppressionRule>true</failBuildOnUnusedSuppressionRule>
                            <skipTestScope>true</skipTestScope>
                            <prettyPrint>true</prettyPrint>
                            <suppressionFiles>
                                <suppressionFile>${maven.multiModuleProjectDirectory}/config/dependency-check-suppressions.xml</suppressionFile>
                            </suppressionFiles>
                            <outputDirectory>${project.build.directory}/d2-security</outputDirectory>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Build-time supply chain, scanned separately from the distributed product.

            The product SBOM and the d2-security scan deliberately exclude test scope: a JUnit or ArchUnit
            artifact is never shipped, and listing it as a product component would misdescribe what an operator
            installs. It is still executed on every CI machine that builds MORPHEUS, so excluding it from the
            product view must not mean nobody looks at it. This profile is that second look, and it is
            fail-closed on the same CVSS threshold: a critical vulnerability in something the build runs is a
            critical vulnerability in the build.
        -->
        <profile>
            <id>d2-security-tests</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${dependency-check.maven.plugin.version}</version>
                        <inherited>false</inherited>
                        <configuration>
                            <format>ALL</format>
                            <failBuildOnCVSS>7.0</failBuildOnCVSS>
                            <junitFailOnCVSS>4.0</junitFailOnCVSS>
                            <failOnError>true</failOnError>
                            <!--
                                failBuildOnUnusedSuppressionRule stays on the product scan alone: the suppression
                                file is the same one, so a stale rule is already caught there, and asserting it
                                twice over two different dependency sets only adds a way to fail for a reason that
                                is not a vulnerability.
                            -->
                            <skipTestScope>false</skipTestScope>
                            <prettyPrint>true</prettyPrint>
                            <suppressionFiles>
                                <suppressionFile>${maven.multiModuleProjectDirectory}/config/dependency-check-suppressions.xml</suppressionFile>
                            </suppressionFiles>
                            <outputDirectory>${project.build.directory}/d2-security-tests</outputDirectory>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Static analysis of production bytecode, opt-in: `./mvnw -Paudit-spotbugs ...`. Nothing here runs in a
            plain `clean verify`. The plugin is declared in <plugins> (not only pluginManagement) so that every
            module with production classes inherits it; the check goal is bound to verify, and a module without
            classes (architecture tests, coverage report) is skipped by the plugin itself, not excluded by name.

            Reports without failing: add -Dspotbugs.failOnError=false. The blocking check is the same run
            without it. See docs/developer/CODE_AUDIT.md.
        -->
        <profile>
            <id>audit-spotbugs</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <version>${spotbugs.maven.plugin.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>com.github.spotbugs</groupId>
                                <artifactId>spotbugs</artifactId>
                                <version>${spotbugs.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <effort>Max</effort>
                            <threshold>Medium</threshold>
                            <maxRank>20</maxRank>
                            <maxAllowedViolations>0</maxAllowedViolations>
                            <includeTests>false</includeTests>
                            <xmlOutput>true</xmlOutput>
                            <htmlOutput>true</htmlOutput>
                            <excludeFilterFile>${maven.multiModuleProjectDirectory}/config/spotbugs-exclude.xml</excludeFilterFile>
                        </configuration>
                        <executions>
                            <execution>
                                <id>audit-spotbugs-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Mutation testing, opt-in and one module at a time: `./mvnw -Paudit-mutation ... -pl NAME`. The
            plugin is NOT bound to any phase: PIT is invoked by its goal, never by `verify`. The default scope is
            a small, deterministic part of morpheus-domain; every knob below is a pit.* property so the scope
            changes from the command line without editing this file.

            PIT runs the tests of the module it is launched in. A test living in another module (the
            architecture tests, for instance) is not on this classpath and cannot kill a mutation, whatever the
            targetTests pattern says. See docs/developer/CODE_AUDIT.md.
        -->
        <profile>
            <id>audit-mutation</id>
            <properties>
                <pit.targetClasses>com.morpheus.domain.constraint.*,com.morpheus.domain.change.lifecycle.*</pit.targetClasses>
                <pit.targetTests>com.morpheus.domain.constraint.*,com.morpheus.domain.change.lifecycle.*</pit.targetTests>
                <pit.threads>2</pit.threads>
                <pit.timeoutConstant>4000</pit.timeoutConstant>
                <pit.timeoutFactor>1.25</pit.timeoutFactor>
                <!--
                    Not a quality bar: PIT ends in BUILD SUCCESS with every mutation NO_COVERAGE when the test
                    pattern matches no test, so one covered line in the mutated classes is required for the run
                    to mean anything. There is deliberately no mutation threshold before a first measurement.
                -->
                <pit.coverageThreshold>1</pit.coverageThreshold>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.maven.plugin.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest.junit5.plugin.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>${pit.targetClasses}</targetClasses>
                            <targetTests>${pit.targetTests}</targetTests>
                            <threads>${pit.threads}</threads>
                            <timeoutConstant>${pit.timeoutConstant}</timeoutConstant>
                            <timeoutFactor>${pit.timeoutFactor}</timeoutFactor>
                            <coverageThreshold>${pit.coverageThreshold}</coverageThreshold>
                            <outputFormats>
                                <outputFormat>HTML</outputFormat>
                                <outputFormat>XML</outputFormat>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                            <reportsDirectory>${project.build.directory}/pit-reports</reportsDirectory>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>