# Maven
**/target/

# IntelliJ IDEA
.idea/
*.iml

# Eclipse / generic Java tooling
.classpath
.project
.settings/

# Local databases and runtime files
*.db
*.sqlite
*.sqlite3
# The databases published programs wrote are test fixtures, compared by checksum.
!morpheus-store-sqlite/src/test/resources/published-databases/level-*/morpheus.db

# Local distribution artifacts
dist/
validation-output/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Permissions Claude Code propres a une machine : .claude/settings.json porte
# ce dont tout contributeur a besoin, settings.local.json le reste.
.claude/settings.local.json

# Local RTK output filter: the maintainer keeps it on their machine, it is not published
.rtk/

# Identity files and key material of a MORPHEUS server. SECURITY.md forbids committing them, and the remote server
# accepts any path for both, this working tree included. RepositoryCredentialHygieneTest holds these lines and refuses
# a tracked file that matches one.
remote-auth*.txt
*.p12
*.jks
*.pfx
*.pem
*.key

# Archgate generated runtime (regenerated by archgate check)
.archgate/rules.d.ts
docs/architecture/rules.d.ts
