{
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(mvnw.cmd *)",
      "Bash(powershell * .claude/hooks/*.ps1*)",
      "Bash(powershell * scripts/*.ps1*)",
      "Bash(bash scripts/*.sh *)"
    ],
    "deny": [
      "Bash(git push --force *main*)",
      "Bash(git push --force *develop*)",
      "Bash(git push --force *master*)",
      "Bash(git push -f *main*)",
      "Bash(git push -f *develop*)",
      "Bash(git push -f *master*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -File .claude/hooks/post-edit.ps1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NonInteractive -File .claude/hooks/pre-bash.ps1"
          }
        ]
      }
    ]
  }
}
